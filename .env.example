# TRUSTMATE local configuration template. Copy to .env and fill values locally.
# Never commit or share .env.

# Application
APP_NAME=TRUSTMATE-MCP
APP_ENV=development
MOCK=false
PORT=8000
LOG_LEVEL=INFO

# MCP transport security
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
MCP_BEARER_TOKEN=

# Product discovery: Channel3
PRODUCT_PROVIDER=channel3
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_TIMEOUT_SECONDS=10
CHANNEL3_MAX_RETRIES=2

# Business presence: Foursquare
BUSINESS_PROVIDER=foursquare
FOURSQUARE_API_KEY=
FOURSQUARE_BASE_URL=https://places-api.foursquare.com
FOURSQUARE_API_VERSION=2025-06-17
FOURSQUARE_TIMEOUT_SECONDS=10
FOURSQUARE_MAX_RETRIES=2
FOURSQUARE_PREMIUM_ENABLED=false

# Business fallback: OpenStreetMap / Nominatim
BUSINESS_FALLBACK_PROVIDER=openstreetmap
OSM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=TRUSTMATE/0.1 (contact: replace-with-your-email)
OSM_CONTACT_EMAIL=
OSM_TIMEOUT_SECONDS=10
OSM_CACHE_TTL_SECONDS=3600

# Reputation: URLhaus
REPUTATION_PROVIDER=urlhaus
URLHAUS_AUTH_KEY=
URLHAUS_AUTHORIZED=false
URLHAUS_LIVE_TEST=false
URLHAUS_BASE_URL=https://urlhaus-api.abuse.ch
URLHAUS_TIMEOUT_SECONDS=10
URLHAUS_MAX_RETRIES=1
# Leave both authorization flags false and the Auth-Key empty until the
# intended use is explicitly permitted and reviewed.

# Domain registration: RDAP
DOMAIN_PROVIDER=rdap
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT_SECONDS=10
RDAP_CACHE_TTL_SECONDS=3600
RDAP_LIVE_TEST=false

# Native website checks
WEBSITE_PROVIDER=native
WEBSITE_TIMEOUT_SECONDS=10
WEBSITE_MAX_PAGES=4

# Optional seller-domain -> verified physical locality map (JSON object).
# This is only a search hint, never seller identity proof.
SELLER_LOCATION_HINTS_JSON=

# AI explanations only; never used for scoring or ranking.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXPLAINER_ENABLED=false
OPENROUTER_TIMEOUT_SECONDS=15
OPENROUTER_MAX_RETRIES=2

# Neon PostgreSQL
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Local SQLite assessment and explanation cache (72-hour TTL).
SQLITE_PATH=./data/trustmate.sqlite
CACHE_TTL_DAYS=3
# Legacy/provider-cache settings retained for the existing Neon schema.
CACHE_TTL_HOURS=72
CACHE_MAX_ENTRIES=256

# Seller-specific service reviews (optional; Trustpilot Insights entitlement required)
REVIEW_PROVIDER=none
TRUSTPILOT_API_KEY=
TRUSTPILOT_BASE_URL=https://datasolutions.trustpilot.com/v1
TRUSTPILOT_TIMEOUT_SECONDS=10
TRUSTPILOT_MAX_REVIEW_PAGES=5
